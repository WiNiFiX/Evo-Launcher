            <Setter Property="FontFamily" Value="Georgia"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="8,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Path Name="JaggedPath" Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="3"
                                  Data="M 0,4 L 12,0 L 25,6 L 38,1 L 52,5 L 67,0 L 82,3 L 96,7 L 111,2 L 125,4 L 140,0 L 155,5 L 170,1 L 185,6 L 200,2 L 215,4 L 230,0 L 245,3 L 260,7 L 275,1 L 290,5 L 305,0 L 320,4 L 335,2 L 350,6 L 365,0 L 380,3 L 395,5 L 410,1 L 425,4 L 440,0 L 455,6 L 470,2 L 480,4 L 480,12 L 476,22 L 480,32 L 475,42 L 480,52 L 478,62 L 480,72 L 474,82 L 480,92 L 476,102 L 480,112 L 477,122 L 480,125 L 470,130 L 455,126 L 440,132 L 425,127 L 410,131 L 395,128 L 380,132 L 365,129 L 350,131 L 335,128 L 320,132 L 305,129 L 290,131 L 275,127 L 260,130 L 245,126 L 230,132 L 215,128 L 200,131 L 185,126 L 170,130 L 155,127 L 140,131 L 125,128 L 111,132 L 96,127 L 82,130 L 67,126 L 52,132 L 38,128 L 25,131 L 12,127 L 0,130 L 0,120 L 4,110 L 0,100 L 6,90 L 0,80 L 3,70 L 0,60 L 5,50 L 0,40 L 4,30 L 0,20 L 2,10 Z">
                                <Path.Effect>
                                    <DropShadowEffect Color="#000000" Direction="315" ShadowDepth="3" Opacity="0.5" BlurRadius="2"/>
                                </Path.Effect>
                            </Path>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="15,10"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="JaggedPath" Property="Fill" Value="#A0522D"/>
                                <Setter TargetName="JaggedPath" Property="Stroke" Value="#8B4513"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="JaggedPath" Property="Fill" Value="#654321"/>
                                <Setter TargetName="JaggedPath" Property="Stroke" Value="#4A2C17"/>
                            </Trigger>
